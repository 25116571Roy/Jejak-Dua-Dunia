tool
extends Resource
class_name PlayerData

@export var player_id: String = ""
@export var color: Color = Color.WHITE
@export var radius: float = 50.0
@export var max_stamina: float = 100.0
@export var current_stamina: float = 100.0
@export var speed: float = 200.0
@export var jump_force: float = -600.0
@export var double_jump_force: float = -300.0
@export var dash_speed: float = 700.0
@export var dash_duration: float = 0.8
@export var dash_cooldown: float = 0.8
@export var attack_damage: float = 10.0
@export var attack_cooldown: float = 0.5
@export var parry_cooldown: float = 0.3
@export var taunt_cooldown: float = 0.45
@export var finisher_cooldown: float = 1.0
@export var weakpoint_cooldown: float = 0.3
@export var weakpoint_attack_cooldown: float = 0.3
@export var should_emphasize_armor: bool = false
@export var should_emphasize_agility: bool = false

var player_id_value: String setget set_player_id
var color_value: Color
var radius_value: float
var max_stamina_value: float
var current_stamina_value: float
var move_left_key: String = ""
var move_right_key: String = ""
var jump_key: String = ""
var attack_key: String = ""
var dash_key: String = ""
var dash_pos_one: String = ""
var dash_pos_two: String = ""
var taunt_key: String = ""
var parry_key: String = ""
var parry_pos_one: String = ""
var parry_pos_two: String = ""
var finisher_key: String = ""
var finisher_pos_one: String = ""
var finisher_pos_two: String = ""
var weakpoint_key: String = ""
var weakpoint_pos_one: String = ""
var weakpoint_pos_two: String = ""

func set_player_id(value: String):
	player_id_value = value player_id = value

func get_player_id():
	return player_id_value

func get_color():
	return color_value

func get_radius():
	return radius_value

func get_max_stamina():
	return max_stamina_value

func get_current_stamina():
	return current_stamina_value

func get_speed():
	return speed

func get_jump_force():
	return jump_force

func get_double_jump_force():
	return double_jump_force

func get_dash_speed():
	return dash_speed

func get_dash_duration():
	return dash_duration

func get_dash_cooldown():
	return dash_cooldown

func get_attack_damage():
	return attack_damage

func get_attack_cooldown():
	return attack_cooldown

func get_parry_cooldown():
	return parry_cooldown

func get_taunt_cooldown():
	return taunt_cooldown

func get_finisher_cooldown():
	return finisher_cooldown

func get_weakpoint_cooldown():
	return weakpoint_cooldown

func get_weakpoint_attack_cooldown():
	return weakpoint_attack_cooldown

func is_armor_based():
	return should_emphasize_armor

func is_agility_based():
	return should_emphasize_agility